{
  "mcpServers": {
    "muse-agent": {
      "command": "ssh",
      "args": [
        "-T",
        "-o",
        "BatchMode=yes",
        "-o",
        "StrictHostKeyChecking=yes",
        "-o",
        "PasswordAuthentication=no",
        "agent-pc",
        "node \"C:/Tools/muse-link/bin/muse-link.mjs\" mcp agent"
      ]
    }
  }
}
