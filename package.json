{
  "name": "@gitwrld999/muse-link",
  "version": "1.4.1",
  "description": "Connect agents to a signed-in Windows desktop over SSH and MCP.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gitWRLD999/muse-link.git"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "muse-link": "bin/muse-link.mjs"
  },
  "files": [
    "bin/*.mjs",
    "src/*.mjs",
    "scripts/*.ps1",
    "scripts/*.py",
    "scripts/*.txt",
    "examples/*.json",
    "docs/*.md",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "start": "node bin/muse-link.mjs serve"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1"
  },
  "optionalDependencies": {
    "@playwright/mcp": "0.0.82"
  }
}
